# Скопируйте в .env и заполните:
#   cp .env.example .env && chmod 600 .env
# Файл .env в .gitignore — реальные ключи в репозиторий не попадают.

# Ключ LLM-провайдера (DeepSeek). Нужен для блока LLM.
LLM_API_KEY=sk-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Адрес OpenAI-совместимого API. По умолчанию DeepSeek.
LLM_BASE_URL=https://api.deepseek.com

# --- Необязательные настройки сервиса ---
# PORT=8092
# HOST=0.0.0.0
# RATE=16000
# SOURCE=alsa_input.usb-C-Media_Electronics_Inc._USB_PnP_Sound_Device-00.analog-mono
# IDLE_STOP_MS=8000
# PYTHON=/home/r/bin/python3
# VAD_MODEL=/home/r/.local/opt/silero-vad/silero_vad.onnx
# PIPER_PREFIX=/home/r/.local/opt/piper
# PIPER_VOICES=/home/r/.local/opt/piper/voices
# ESPEAK_BIN=/home/r/.local/opt/espeak-ng/usr/bin/espeak-ng
# RHVOICE_PREFIX=/home/r/.local/opt/rhvoice
